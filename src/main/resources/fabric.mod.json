{
  "schemaVersion": 1,
  "id": "violet",
  "version": "${version}",
  "name": "Violet",
  "description": "General purpose fabric utility mod. Based on NoFrills <3\nOpen menu with /violet or right shift (can be customized in ClickGui feature)",
  "authors": [
    "capsoffpls"
  ],
  "contact": {
    "sources": "https://github.com/capsoffpls/violet",
    "discord": ".javie"
  },
  "license": "GPL-3.0",
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "violet.Main"
    ]
  },
  "mixins": [
    "violet.mixins.json"
  ],
  "accessWidener" : "violet.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "owo-lib": "*",
    "minecraft": ">=${minecraft_version}",
    "java": ">=25"
  }
}